nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_sarek"
    tag "aligner_giraffe"

    def test_scenario = [
        [
            name: "-profile test --aligner giraffe --save_reference skip QC/recal/md",
            params: [
                aligner: 'giraffe',
                save_reference: true,
                skip_tools: 'baserecalibrator,fastqc,markduplicates,mosdepth,multiqc,samtools',
                tools: '',
                // Pangenome indices from vg haplotype-sampling test data
                pangenome_gbz: "${params.pangenome_test_data_base}/micb-kir3dl1.giraffe.gbz",
                pangenome_dist: "${params.pangenome_test_data_base}/micb-kir3dl1.dist",
                pangenome_min: "${params.pangenome_test_data_base}/micb-kir3dl1.shortread.withzip.min",
                // Use GRCh38 reference extracted from pangenome
                fasta: "${params.pangenome_test_data_base}/micb-kir3dl1.GRCh38.fa",
                fasta_fai: "${params.pangenome_test_data_base}/micb-kir3dl1.GRCh38.fa.fai",
                dict: "${params.pangenome_test_data_base}/micb-kir3dl1.GRCh38.dict"
            ]
        ],
        [
            name: "-profile test --aligner giraffe --save_reference skip QC/recal/md -stub",
            params: [
                aligner: 'giraffe',
                save_reference: true,
                skip_tools: 'baserecalibrator,fastqc,markduplicates,mosdepth,multiqc,samtools',
                tools: '',
                // Pangenome indices from vg haplotype-sampling test data
                pangenome_gbz: "${params.pangenome_test_data_base}/micb-kir3dl1.giraffe.gbz",
                pangenome_dist: "${params.pangenome_test_data_base}/micb-kir3dl1.dist",
                pangenome_min: "${params.pangenome_test_data_base}/micb-kir3dl1.shortread.withzip.min",
                // Use GRCh38 reference extracted from pangenome
                fasta: "${params.pangenome_test_data_base}/micb-kir3dl1.GRCh38.fa",
                fasta_fai: "${params.pangenome_test_data_base}/micb-kir3dl1.GRCh38.fa.fai",
                dict: "${params.pangenome_test_data_base}/micb-kir3dl1.GRCh38.dict"
            ],
            stub: true
        ]
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.get_test(scenario))
    }
}
