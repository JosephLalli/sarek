/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'

    // Pangenome test data (from vg haplotype-sampling tests)
    pangenome_test_data_base = "${projectDir}/assets/test_data/pangenome/haplotype-sampling"
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

process {
    withName: 'SENTIEON_VARCAL_SNP' {
        // complains that training data is constant for MQRankSum, ReadPosRankSum, SOR
        ext.args   = { '--annotation QD  --annotation FS --annotation DP --var_type SNP' }
    }
}

// NOTE: Sentieon licensing configuration
// - For real-world use: set SENTIEON_LICSRVR_IP environment variable
// - For GitHub actions: set SENTIEON_AUTH_MECH environment variable
// - For secrets-based auth: nextflow secrets set SENTIEON_AUTH_DATA <value>
// - For license file: nextflow secrets set SENTIEON_LICENSE_BASE64 $(cat <file.lic> | base64 -w 0)
env {
    SENTIEON_LICENSE   = System.getenv('SENTIEON_LICSRVR_IP') ?: null
    SENTIEON_AUTH_MECH = System.getenv('SENTIEON_AUTH_MECH') ?: null
    SENTIEON_AUTH_DATA = System.getenv('SENTIEON_AUTH_DATA') ?: null
}
