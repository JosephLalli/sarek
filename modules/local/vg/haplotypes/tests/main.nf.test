nextflow_process {

    name "Test Process VG_HAPLOTYPES"
    script "../main.nf"
    process "VG_HAPLOTYPES"

    tag "modules"
    tag "modules_local"
    tag "vg"
    tag "vg_haplotypes"

    test("Extract haplotypes (Stub)") {
        options "-stub"
        when {
            process {
                """
                input[0] = [ [id:'test'], file("test.gbz"), file("test.dist") ]
                input[1] = [ [id:'test'], file("test.kmer") ]
                input[2] = []
                input[3] = []
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
