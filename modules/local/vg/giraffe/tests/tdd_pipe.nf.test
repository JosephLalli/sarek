nextflow_process {

    name "Test Process VG_GIRAFFE (TDD)"
    script "../main.nf"
    process "VG_GIRAFFE"

    tag "modules"
    tag "modules_local"
    tag "vg"
    tag "vg_giraffe"

    test("TDD: Post-Processing Pipe Logic - Stub") {
        options "-stub"
        config "./tdd.config"
        setup {
            // Using existing project assets
            def test_data_base = "${baseDir}/assets/test_data/pangenome/haplotype-sampling"
        }
        when {
            process {
                """
                def test_data_base = "\${baseDir}/assets/test_data/pangenome/haplotype-sampling"
                // [meta, reads, gbz, dist, min, zipcodes]
                input[0] = [
                    [ id:'test', single_end:false ], // meta
                    [
                        file("\${test_data_base}/HG003_R1.fastq.gz"),
                        file("\${test_data_base}/HG003_R2.fastq.gz")
                    ],
                    file("\${test_data_base}/micb-kir3dl1.giraffe.gbz"),
                    file("\${test_data_base}/micb-kir3dl1.dist"),
                    file("\${test_data_base}/micb-kir3dl1.shortread.withzip.min"),
                    file("\${test_data_base}/micb-kir3dl1.shortread.zipcodes")
                ]
                input[1] = [] // ref_paths
                input[2] = [ [id:'fasta'], file("\${test_data_base}/micb-kir3dl1.CHM13.fa") ]
                input[3] = [ [id:'fai'], file("\${test_data_base}/micb-kir3dl1.CHM13.fa.fai") ]
                input[4] = [ [id:'dict'], file("\${test_data_base}/micb-kir3dl1.CHM13.dict") ]
                input[5] = true  // sort_bam
                input[6] = true  // run_markdup
                """
            }
        }

        then {
            assert process.success
            // Assert that CRAM is produced (default for alignment)
            assert process.out.cram != null
            assert process.out.cram.size() == 1
        }
    }
}
