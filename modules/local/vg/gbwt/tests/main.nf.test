nextflow_process {

    name "Test Process VG_GBWT"
    script "../main.nf"
    process "VG_GBWT"

    tag "modules"
    tag "modules_local"
    tag "vg"
    tag "vg_gbwt"

    test("Run GBWT operations (Stub)") {
        options "-stub"
        when {
            process {
                """
                input[0] = [ [id:'test'], file("test.vg") ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
