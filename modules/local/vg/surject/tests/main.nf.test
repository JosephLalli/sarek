nextflow_process {

    name "Test Process VG_SURJECT"
    script "../main.nf"
    process "VG_SURJECT"

    tag "modules"
    tag "modules_local"
    tag "vg"
    tag "vg_surject"

    test("Surject GAM alignments to BAM (Stub)") {
        options "-stub"
        when {
            process {
                """
                input[0] = [ [id:'test'], file("test.gam") ]
                input[1] = [ [id:'pangenome'], file("test.gbz") ]
                input[2] = []
                input[3] = [ [id:'fasta'], file("test.fa") ]
                input[4] = [ [id:'fai'], file("test.fa.fai") ]
                input[5] = [ [id:'dict'], file("test.dict") ]
                input[6] = true
                input[7] = true
                input[8] = true
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
