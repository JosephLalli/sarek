nextflow_process {

    name "Test Process VG_PATHS"
    script "../main.nf"
    process "VG_PATHS"

    tag "modules"
    tag "modules_local"
    tag "vg"
    tag "vg_paths"

    test("List paths in graph (Stub)") {
        options "-stub"
        when {
            process {
                """
                input[0] = [ [id:'test'], file("test.gbz") ]
                input[1] = []
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }

    test("Extract FASTA from graph (Stub)") {
        options "-stub"
        when {
            process {
                """
                input[0] = [ [id:'test'], file("test.gbz") ]
                input[1] = []
                """
            }
            params {
                // Pass -F via task.ext.args
            }
        }
        // Need to set ext.args in config or here
        config "modules/local/vg/paths/tests/nextflow.config"

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
