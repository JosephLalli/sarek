nextflow_process {

    name "Test Process VG_DECONSTRUCT"
    script "../main.nf"
    process "VG_DECONSTRUCT"

    tag "modules"
    tag "modules_local"
    tag "vg"
    tag "vg_deconstruct"

    test("Deconstruct graph to VCF (Stub)") {
        options "-stub"
        when {
            process {
                """
                input[0] = [ [id:'test'], file("test.gbz") ]
                input[1] = []
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
