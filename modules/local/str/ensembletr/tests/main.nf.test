nextflow_process {

    name "Test Process ENSEMBLETR"
    script "modules/local/str/ensembletr/main.nf"
    process "ENSEMBLETR"
    tag "modules"
    tag "modules_local"
    tag "str"
    tag "str/ensembletr"

    test("Functional run (root samples)") {

        when {
            process {
                """
                def eh = file(projectDir + '/tests/test_data/ensembletr/eh.vcf')
                def gs = file(projectDir + '/tests/test_data/ensembletr/gs.vcf')
                def sl = file(projectDir + '/tests/test_data/ensembletr/sl.vcf')
                def ref = file(projectDir + '/tests/test_data/ensembletr/ref.fa')
                def ref_fai = file(projectDir + '/tests/test_data/ensembletr/ref.fa.fai')

                input[0] = [ [ id:'sample1' ], eh, gs, sl, ref, ref_fai ]
                """
            }
        }

        config "modules/local/str/ensembletr/tests/nextflow.config"

        then {
            assertAll(
                { assert process.success },
                {
                    def vcf = path(process.out.vcf[0][1]).readLines()
                    def record = vcf.find { line -> !line.startsWith("#") }
                    assert vcf.any { line -> line.startsWith("##fileformat=VCF") }
                    assert vcf.any { line -> line.startsWith("##INFO=<ID=METHODS") }
                    assert vcf.any { line -> line.startsWith("##FORMAT=<ID=INPUTS") }
                    assert vcf.any { line -> line.startsWith("#CHROM") }
                    assert record != null
                    assert record.contains("METHODS=")
                }
            )
        }

    }

    test("Stub run") {

        options "-stub"

        when {
            process {
                """
                def eh = file(projectDir + '/tests/test_data/ensembletr/eh.vcf')
                def gs = file(projectDir + '/tests/test_data/ensembletr/gs.vcf')
                def sl = file(projectDir + '/tests/test_data/ensembletr/sl.vcf')
                def ref = file(projectDir + '/tests/test_data/ensembletr/ref.fa')
                def ref_fai = file(projectDir + '/tests/test_data/ensembletr/ref.fa.fai')

                input[0] = [ [ id:'sample1' ], eh, gs, sl, ref, ref_fai ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
