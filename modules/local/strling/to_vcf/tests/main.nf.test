nextflow_process {

    name "Test Process STRLING_TO_VCF"
    script "modules/local/strling/to_vcf/main.nf"
    process "STRLING_TO_VCF"
    tag "modules"
    tag "modules_local"
    tag "strling"
    tag "strling/to_vcf"

    test("Root sample conversion (hard gate)") {

        when {
            process {
                """
                input[0] = [
                    [ id:'sample1' ],
                    file(projectDir + '/strling.txt')
                ]
                input[1] = file(projectDir + '/catalog.bed')
                input[2] = file(projectDir + '/hg38.no_alt.fa.fai')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                {
                    def vcfPath = path(process.out.vcf[0][1]).toString()
                    def reader = new BufferedReader(new InputStreamReader(new java.util.zip.GZIPInputStream(new FileInputStream(vcfPath))))
                    def vcf = reader.readLines()
                    reader.close()
                    def header = vcf.findAll { it.startsWith("##") }
                    def record = vcf.find { !it.startsWith("#") }
                    assert header.any { it.contains("##command=hipstr") }
                    assert header.any { it.contains("##contig=<ID=chr1,length=248956422>") }
                    assert header.any { it.contains("##INFO=<ID=START") }
                    assert header.any { it.contains("##INFO=<ID=END") }
                    assert header.any { it.contains("##INFO=<ID=RU") }
                    assert header.any { it.contains("##INFO=<ID=PERIOD") }
                    assert header.any { it.contains("##FORMAT=<ID=REPCN") }
                    assert header.any { it.contains("##FORMAT=<ID=Q") }
                    def refSeq = "CAG" * 7
                    def altSeq = "CAG" * 12
                    assert record.contains(refSeq)
                    assert record.contains(altSeq)
                    assert record.contains("RU=CAG")
                    assert record.contains("START=101")
                    assert record.contains("PERIOD=3")
                    assert record.contains("END=121")
                    assert record.contains("7.00,12.00") // Ref (7) + (0, 5)
                    assert record.contains(":30:") // Q derived from anchored+spanning
                    assert path(process.out.tbi[0][1]).exists()
                    def bcftoolsCheck = ["bash", "-lc", "command -v bcftools"].execute()
                    bcftoolsCheck.waitFor()
                    if (bcftoolsCheck.exitValue() != 0) {
                        System.err.println("WARN: bcftools not available; skipping VCF parse check.")
                    } else {
                        def cmd = ["bcftools", "view", "-h", vcfPath].execute()
                        def stderr = cmd.err.text
                        cmd.waitFor()
                        assert cmd.exitValue() == 0 : "bcftools parse failed: ${stderr}"
                    }
                }
            )
        }

    }

    test("Novel STRling call (soft gate)") {

        when {
            process {
                """
                input[0] = [
                    [ id:'sample1' ],
                    file(projectDir + '/nc30_15-1-genotype.txt')
                ]
                input[1] = file(projectDir + '/tests/test_data/str_enhancement/gangstr_catalog.bed')
                input[2] = file(projectDir + '/tests/test_data/str_enhancement/Homo_sapiens_assembly38.chr4.fasta.fai')
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                {
                    def vcfPath = path(process.out.vcf[0][1]).toString()
                    def reader = new BufferedReader(new InputStreamReader(new java.util.zip.GZIPInputStream(new FileInputStream(vcfPath))))
                    def vcf = reader.readLines()
                    reader.close()
                    def record = vcf.find { !it.startsWith("#") }
                    if (record == null || !record.contains("STRling_Novel_")) {
                        System.err.println("WARN: Expected a novel STRling call, but none was found. Follow up before advancing.")
                    }
                }
            )
        }

    }

    test("Mock data conversion - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'sample1' ],
                    file(projectDir + '/strling_stub.txt')
                ]
                input[1] = file(projectDir + '/catalog_stub.bed')
                input[2] = file(projectDir + '/ref_stub.fai')
                """
            }
        }

        setup {
            path(projectDir + '/catalog_stub.bed').write("test")
            path(projectDir + '/strling_stub.txt').write("test")
            path(projectDir + '/ref_stub.fai').write("chr1\t1000\n")
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
