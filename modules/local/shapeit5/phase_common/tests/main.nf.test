nextflow_process {

    name "Test Process SHAPEIT5_PHASECOMMON"
    script "../main.nf"
    process "SHAPEIT5_PHASECOMMON"

    tag "modules"
    tag "modules_local"
    tag "shapeit5"
    tag "shapeit5_phasecommon"

    test("human - vcf - common - valid large cohort") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta
                    file("${projectDir}/assets/test_data/pangenome/haplotype-sampling/test_50samples.vcf.gz", checkIfExists: true),
                    file("${projectDir}/assets/test_data/pangenome/haplotype-sampling/test_50samples.vcf.gz.tbi", checkIfExists: true),
                    [], // pedigree
                    'chr21', // region
                    file("${projectDir}/assets/test_data/pangenome/haplotype-sampling/reference_50samples.vcf.gz", checkIfExists: true), // reference
                    file("${projectDir}/assets/test_data/pangenome/haplotype-sampling/reference_50samples.vcf.gz.tbi", checkIfExists: true), // reference_index
                    [], // scaffold
                    [], // scaffold_index
                    []  // map
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("human - vcf - common - filtered") {

        config "./filtered.config"

        when {
            process {
                """
                input[0] = [
                    [ id:'test_filtered' ], // meta
                    file("${projectDir}/assets/test_data/pangenome/haplotype-sampling/test_50samples.vcf.gz", checkIfExists: true),
                    file("${projectDir}/assets/test_data/pangenome/haplotype-sampling/test_50samples.vcf.gz.tbi", checkIfExists: true),
                    [], // pedigree
                    'chr21', // region
                    file("${projectDir}/assets/test_data/pangenome/haplotype-sampling/reference_50samples.vcf.gz", checkIfExists: true), // reference
                    file("${projectDir}/assets/test_data/pangenome/haplotype-sampling/reference_50samples.vcf.gz.tbi", checkIfExists: true), // reference_index
                    [], // scaffold
                    [], // scaffold_index
                    []  // map
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("human - vcf - common - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta
                    file("${projectDir}/assets/test_data/pangenome/haplotype-sampling/test_50samples.vcf.gz", checkIfExists: true), // input
                    [], // input_index
                    [], // pedigree
                    'chr21', // region
                    [], // reference
                    [], // reference_index
                    [], // scaffold
                    [], // scaffold_index
                    []  // map
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
