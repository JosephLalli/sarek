nextflow_process {

    name "Test Process JELLYFISH_COUNT"
    script "../main.nf"
    process "JELLYFISH_COUNT"

    tag "modules"
    tag "modules_local"
    tag "jellyfish"
    tag "jellyfish_count"

    test("Count kmers single-end") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], // meta
                    [ file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/illumina/fastq/test_1.fastq.gz", checkIfExists: true) ]
                ]
                input[1] = file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert process.out.kmer_file.size() > 0
            assert snapshot(process.out).match()
        }
    }

    test("Count kmers paired-end") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta
                    [
                        file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/illumina/fastq/test_1.fastq.gz", checkIfExists: true),
                        file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/illumina/fastq/test_2.fastq.gz", checkIfExists: true)
                    ]
                ]
                input[1] = file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert process.out.kmer_file.size() > 0
            assert snapshot(process.out).match()
        }
    }
}
