nextflow_process {

    name "Test Process SAPPHIRE_PHASECALLER"
    script "../main.nf"
    process "SAPPHIRE_PHASECALLER"

    tag "modules"
    tag "modules_local"
    tag "sapphire"
    tag "sapphire_phasecaller"

    test("human - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta
                    file("test.vcf.gz"),
                    file("test.vcf.gz.tbi"),
                    file("test.bin"),
                    [file("test.bam")],
                    [file("test.bam.bai")]
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
