nextflow_process {

    name "Test Process SAPPHIRE_UPDATE"
    script "../main.nf"
    process "SAPPHIRE_UPDATE"

    tag "modules"
    tag "modules_local"
    tag "sapphire"
    tag "sapphire_update"

    test("human - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta
                    file("test.vcf.gz"),
                    file("test.vcf.gz.tbi"),
                    file("test.polished.bin")
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
