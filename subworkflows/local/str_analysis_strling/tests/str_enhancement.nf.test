nextflow_workflow {

    name "Test Subworkflow STR_ANALYSIS_STRLING - STR Enhancement"
    script "../main.nf"
    workflow "STR_ANALYSIS_STRLING"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "strling"
    tag "str_enhancement"

    test("nc30_15 - chr4 - Single Sample (Normal)") {
        when {
            workflow {
                """
                input[0] = Channel.of([ [ id:'nc30_15' ],
                        file("${projectDir}/tests/test_data/str_enhancement/nc30_15.sorted.bam", checkIfExists: true),
                        file("${projectDir}/tests/test_data/str_enhancement/nc30_15.sorted.bam.bai", checkIfExists: true)
                        ])
                input[1] = Channel.of([[id:'fasta'], file("${projectDir}/tests/test_data/str_enhancement/Homo_sapiens_assembly38.chr4.fasta", checkIfExists: true)])
                input[2] = Channel.of([[id:'fasta_fai'], file("${projectDir}/tests/test_data/str_enhancement/Homo_sapiens_assembly38.chr4.fasta.fai", checkIfExists: true)])
                input[3] = Channel.of([[id:'str_index'], []])
                input[4] = Channel.empty() // ch_strling_loci
                input[5] = false // val_joint
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.genotype.size() == 1 },
                { assert workflow.out.bounds.size() == 1 }
            )
        }
    }

    test("nc190_25 - chr4 - Single Sample (Pathogenic)") {
        when {
            workflow {
                """
                input[0] = Channel.of([ [ id:'nc190_25' ],
                        file("${projectDir}/tests/test_data/str_enhancement/nc190_25.sorted.bam", checkIfExists: true),
                        file("${projectDir}/tests/test_data/str_enhancement/nc190_25.sorted.bam.bai", checkIfExists: true)
                        ])
                input[1] = Channel.of([[id:'fasta'], file("${projectDir}/tests/test_data/str_enhancement/Homo_sapiens_assembly38.chr4.fasta", checkIfExists: true)])
                input[2] = Channel.of([[id:'fasta_fai'], file("${projectDir}/tests/test_data/str_enhancement/Homo_sapiens_assembly38.chr4.fasta.fai", checkIfExists: true)])
                input[3] = Channel.of([[id:'str_index'], []])
                input[4] = Channel.empty() // ch_strling_loci
                input[5] = false // val_joint
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.genotype.size() == 1 },
                { assert workflow.out.bounds.size() == 1 },
                // Verify that the expansion was found in the genotype file
                {
                    def genotypeFile = workflow.out.genotype[0][1]
                    def lines = new File(genotypeFile).readLines()
                    assert lines.size() > 1
                    def expansionLine = lines.find { it.contains("3074907") && it.contains("AGC") }
                    assert expansionLine != null
                    def columns = expansionLine.split('\t')
                    def allele2_est = columns[5].toDouble()
                    assert allele2_est > 100
                }
            )
        }
    }

    test("Joint Calling - Two Samples") {
        when {
            workflow {
                """
                input[0] = Channel.of(
                    [ [ id:'nc30_15' ],
                      file("${projectDir}/tests/test_data/str_enhancement/nc30_15.sorted.bam", checkIfExists: true),
                      file("${projectDir}/tests/test_data/str_enhancement/nc30_15.sorted.bam.bai", checkIfExists: true)
                    ],
                    [ [ id:'nc190_25' ],
                      file("${projectDir}/tests/test_data/str_enhancement/nc190_25.sorted.bam", checkIfExists: true),
                      file("${projectDir}/tests/test_data/str_enhancement/nc190_25.sorted.bam.bai", checkIfExists: true)
                    ]
                )
                input[1] = Channel.of([[id:'fasta'], file("${projectDir}/tests/test_data/str_enhancement/Homo_sapiens_assembly38.chr4.fasta", checkIfExists: true)])
                input[2] = Channel.of([[id:'fasta_fai'], file("${projectDir}/tests/test_data/str_enhancement/Homo_sapiens_assembly38.chr4.fasta.fai", checkIfExists: true)])
                input[3] = Channel.of([[id:'str_index'], []])
                input[4] = Channel.empty() // ch_strling_loci
                input[5] = true // val_joint = TRUE
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.genotype.size() == 2 }, // Both samples output genotypes
                { assert workflow.out.bounds.size() == 2 } // Both samples output bounds (re-genotyped)
            )
        }
    }
}