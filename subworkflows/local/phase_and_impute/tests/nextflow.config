process {
    withName: '.*SHAPEIT5_PHASECOMMON' {
        ext.args = '--filter-maf 0.1'
    }
    withName: '.*BCFTOOLS_VIEW_FILTER_MAF' {
        // Keep variants with MAF >= 0.001 for SHAPEIT4 input
        // Very rare variants will be phased by SHAPEIT5_PHASERARE
        ext.args = "-i 'MAF>=0.001' -Oz -W"
    }
    withName: '.*SHAPEIT5_PHASERARE' {
        // Use single thread for small test datasets to avoid potential threading issues
        cpus = 1
    }
}