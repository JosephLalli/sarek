/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for pangenome alignment (vg giraffe)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines pangenome graph indices for vg giraffe alignment.
    Supports HPRC pangenome v1.1 and v2.

    Pangenome indices are hosted on public S3 alongside igenomes.
    Uses ${params.igenomes_base} as the base path.

    Usage:
        --pangenome_version     Select pangenome version: 'v1.1' or 'v2' (default: 'v1.1')
        --aligner giraffe       Enable pangenome alignment

    TODO: Fill in actual S3 URLs for pangenome indices when available
----------------------------------------------------------------------------------------
*/

params {
    // Pangenome version selection
    pangenome_version = 'v1.1'

    // Pangenome index definitions (follows igenomes pattern)
    // TODO: Replace placeholder paths with actual S3 URLs
    pangenomes {
        // HPRC Pangenome v1.1 (Minigraph-Cactus, CHM13-based)
        // Reference: https://github.com/human-pangenomics/hpp_pangenome_resources
        // TODO: S3 paths for HPRC v1.1 indices
        'v1.1' {
            // Core graph indices for vg giraffe
            gbz                 = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1/hprc-v1.1-mc-chm13.gbz"
            dist                = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1/hprc-v1.1-mc-chm13.dist"
            min                 = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1/hprc-v1.1-mc-chm13.min"

            // Optional indices (for advanced workflows)
            xg                  = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1/hprc-v1.1-mc-chm13.xg"
            snarls              = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1/hprc-v1.1-mc-chm13.snarls"
            hapl                = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1/hprc-v1.1-mc-chm13.hapl"
            ri                  = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1/hprc-v1.1-mc-chm13.ri"

            // Reference genome for surjection (CHM13 v1.1 coordinates)
            surject_fasta       = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1/CHM13v1.1.fa"
            surject_fasta_fai   = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1/CHM13v1.1.fa.fai"

            // Metadata
            reference_prefix    = 'CHM13#0#'
            num_haplotypes      = 90
            description         = 'HPRC Year 1 Minigraph-Cactus pangenome (47 diploid samples)'
        }

        // HPRC Pangenome v2 (updated graph with more samples)
        // TODO: S3 paths for HPRC v2 indices (update when released)
        'v2' {
            // Core graph indices for vg giraffe
            gbz                 = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v2/hprc-v2-mc-chm13.gbz"
            dist                = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v2/hprc-v2-mc-chm13.dist"
            min                 = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v2/hprc-v2-mc-chm13.min"

            // Optional indices
            xg                  = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v2/hprc-v2-mc-chm13.xg"
            snarls              = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v2/hprc-v2-mc-chm13.snarls"
            hapl                = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v2/hprc-v2-mc-chm13.hapl"
            ri                  = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v2/hprc-v2-mc-chm13.ri"

            // Reference genome for surjection (CHM13 v2.0 coordinates)
            surject_fasta       = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v2/chm13v2.0.fa"
            surject_fasta_fai   = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v2/chm13v2.0.fa.fai"

            // Metadata
            reference_prefix    = 'CHM13#0#'
            num_haplotypes      = null  // TBD
            description         = 'HPRC v2 Minigraph-Cactus pangenome'
        }

        // GRCh38-based pangenome (for compatibility with GRCh38 workflows)
        // TODO: S3 paths for GRCh38-based pangenome
        'v1.1-grch38' {
            gbz                 = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1_GRCh38/hprc-v1.1-mc-grch38.gbz"
            dist                = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1_GRCh38/hprc-v1.1-mc-grch38.dist"
            min                 = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1_GRCh38/hprc-v1.1-mc-grch38.min"

            surject_fasta       = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1_GRCh38/GRCh38_no_alt.fa"
            surject_fasta_fai   = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1_GRCh38/GRCh38_no_alt.fa.fai"

            reference_prefix    = 'GRCh38#0#'
            num_haplotypes      = 90
            description         = 'HPRC Year 1 Minigraph-Cactus pangenome (GRCh38 reference)'
        }
    }

    // PanGenie genotyping resources
    // TODO: S3 paths for PanGenie panel files
    pangenie {
        'v1.1' {
            panel_vcf           = "${params.igenomes_base}/Homo_sapiens/Pangenome/PanGenie/v1.1/hprc-v1.1.pangenie_panel.vcf.gz"
            panel_vcf_tbi       = "${params.igenomes_base}/Homo_sapiens/Pangenome/PanGenie/v1.1/hprc-v1.1.pangenie_panel.vcf.gz.tbi"
            reference_fasta     = "${params.igenomes_base}/Homo_sapiens/Pangenome/PanGenie/v1.1/CHM13v1.1.fa"
        }
        'v2' {
            panel_vcf           = "${params.igenomes_base}/Homo_sapiens/Pangenome/PanGenie/v2/hprc-v2.pangenie_panel.vcf.gz"
            panel_vcf_tbi       = "${params.igenomes_base}/Homo_sapiens/Pangenome/PanGenie/v2/hprc-v2.pangenie_panel.vcf.gz.tbi"
            reference_fasta     = "${params.igenomes_base}/Homo_sapiens/Pangenome/PanGenie/v2/chm13v2.0.fa"
        }
    }

    // Phasing resources (for phase_and_impute workflow)
    // TODO: S3 paths for phasing panel files
    phasing {
        // 1000 Genomes phasing panel lifted to T2T
        't2t' {
            panel               = "${params.igenomes_base}/Homo_sapiens/Pangenome/Phasing/T2T/1KGP.CHM13v2.{1..22,X}.phased.bcf.gz"
            panel_index         = "${params.igenomes_base}/Homo_sapiens/Pangenome/Phasing/T2T/1KGP.CHM13v2.{1..22,X}.phased.bcf.gz.csi"
            genetic_map         = "${params.igenomes_base}/Homo_sapiens/Pangenome/Phasing/T2T/genetic_maps/*.gmap.gz"
        }
        'grch38' {
            panel               = "${params.igenomes_base}/Homo_sapiens/Pangenome/Phasing/GRCh38/1KGP.GRCh38.{1..22,X}.phased.bcf.gz"
            panel_index         = "${params.igenomes_base}/Homo_sapiens/Pangenome/Phasing/GRCh38/1KGP.GRCh38.{1..22,X}.phased.bcf.gz.csi"
            genetic_map         = "${params.igenomes_base}/Homo_sapiens/Pangenome/Phasing/GRCh38/genetic_maps/*.gmap.gz"
        }
    }
}
