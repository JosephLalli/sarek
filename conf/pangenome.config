/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for pangenome alignment (vg giraffe)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines pangenome graph indices for vg giraffe alignment.
    Supports HPRC pangenome v1.1 and v2.

    Pangenome indices are hosted on public S3 alongside igenomes.
    Uses ${params.igenomes_base} as the base path.

    Usage:
        --pangenome_version     Select pangenome version: 'v1.1' or 'v2' (default: 'v1.1')
        --aligner giraffe       Enable pangenome alignment
----------------------------------------------------------------------------------------
*/

params {
    // Pangenome version selection
    pangenome_version = 'v1.1'

    // Pangenome index definitions
    pangenomes {
        // HPRC Pangenome v1.1 (Minigraph-Cactus, CHM13-based)
        // Reference: https://github.com/human-pangenomics/hpp_pangenome_resources
        'v1.1' {
            // Core graph indices for vg giraffe
            gbz                 = "s3://human-pangenomics/pangenomes/freeze/freeze1/minigraph-cactus/hprc-v1.1-mc-chm13/hprc-v1.1-mc-chm13.gbz"
            dist                = "s3://human-pangenomics/pangenomes/freeze/freeze1/minigraph-cactus/hprc-v1.1-mc-chm13/hprc-v1.1-mc-chm13.dist"
            min                 = "s3://human-pangenomics/pangenomes/freeze/freeze1/minigraph-cactus/hprc-v1.1-mc-chm13/hprc-v1.1-mc-chm13.min"

            // Optional indices (for advanced workflows)
            xg                  = "s3://human-pangenomics/pangenomes/freeze/freeze1/minigraph-cactus/hprc-v1.1-mc-chm13/hprc-v1.1-mc-chm13.xg"
            snarls              = "s3://human-pangenomics/pangenomes/freeze/freeze1/minigraph-cactus/hprc-v1.1-mc-chm13/hprc-v1.1-mc-chm13.snarls"
            hapl                = "s3://human-pangenomics/pangenomes/freeze/freeze1/minigraph-cactus/hprc-v1.1-mc-chm13/hprc-v1.1-mc-chm13.hapl"
            ri                  = "s3://human-pangenomics/pangenomes/freeze/freeze1/minigraph-cactus/hprc-v1.1-mc-chm13/hprc-v1.1-mc-chm13.ri"

            // Reference genome for surjection (CHM13 v1.1 coordinates)
            surject_fasta       = "s3://human-pangenomics/T2T/CHM13/assemblies/chm13.v1.1.fasta"
            // TODO: FAI file is usually alongside fasta, check if it exists or needs generation
            surject_fasta_fai   = "s3://human-pangenomics/T2T/CHM13/assemblies/chm13.v1.1.fasta.fai"

            // Metadata
            reference_prefix    = 'CHM13#0#'
            num_haplotypes      = 90
            description         = 'HPRC Year 1 Minigraph-Cactus pangenome (47 diploid samples)'
        }

        // HPRC Pangenome v2 (updated graph with more samples)
        'v2' {
            // Core graph indices for vg giraffe
            // NOTE: .dist and .min are missing from the bucket and must be generated via the pangenome_prep workflow
            gbz                 = "s3://human-pangenomics/pangenomes/freeze/release2/minigraph-cactus/hprc-v2.0-mc-chm13.gbz"
            dist                = null // Needs generation
            min                 = null // Needs generation

            // Optional indices
            xg                  = null
            snarls              = null
            hapl                = "s3://human-pangenomics/pangenomes/freeze/release2/minigraph-cactus/hprc-v2.0-mc-chm13.hapl"
            ri                  = null

            // Reference genome for surjection (CHM13 v2.0 coordinates)
            surject_fasta       = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v2/chm13v2.0.fa"
            surject_fasta_fai   = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v2/chm13v2.0.fa.fai"

            // Metadata
            reference_prefix    = 'CHM13#0#'
            num_haplotypes      = null  // TBD
            description         = 'HPRC v2 Minigraph-Cactus pangenome'
        }

        // GRCh38-based pangenome (for compatibility with GRCh38 workflows)
        'v1.1-grch38' {
            gbz                 = "s3://human-pangenomics/pangenomes/freeze/freeze1/minigraph-cactus/hprc-v1.1-mc-grch38/hprc-v1.1-mc-grch38.gbz"
            dist                = "s3://human-pangenomics/pangenomes/freeze/freeze1/minigraph-cactus/hprc-v1.1-mc-grch38/hprc-v1.1-mc-grch38.dist"
            min                 = "s3://human-pangenomics/pangenomes/freeze/freeze1/minigraph-cactus/hprc-v1.1-mc-grch38/hprc-v1.1-mc-grch38.min"

            surject_fasta       = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1_GRCh38/GRCh38_no_alt.fa"
            surject_fasta_fai   = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1_GRCh38/GRCh38_no_alt.fa.fai"

            reference_prefix    = 'GRCh38#0#'
            num_haplotypes      = 90
            description         = 'HPRC Year 1 Minigraph-Cactus pangenome (GRCh38 reference)'
        }
    }

    // PanGenie genotyping resources
    pangenie {
        'v1.1' {
            // Zenodo record: https://zenodo.org/record/7839719
            panel_vcf           = "https://zenodo.org/record/7839719/files/chm13_cactus_filtered_ids.vcf.gz"
            panel_vcf_tbi       = "https://zenodo.org/record/7839719/files/chm13_cactus_filtered_ids.vcf.gz.tbi" // Assumed standard naming
            reference_fasta     = "s3://human-pangenomics/T2T/CHM13/assemblies/chm13.v1.1.fasta"
        }
        'v1.1-grch38' {
             // Zenodo record: https://zenodo.org/record/6797328
            panel_vcf           = "https://zenodo.org/record/6797328/files/cactus_filtered_ids.vcf.gz"
            panel_vcf_tbi       = "https://zenodo.org/record/6797328/files/cactus_filtered_ids.vcf.gz.tbi" // Assumed standard naming
            reference_fasta     = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v1.1_GRCh38/GRCh38_no_alt.fa"
        }
        'v2' {
            // S3 path provided
            panel_vcf           = "s3://human-pangenomics/submissions/89DF6EFF-E289-49A2-B2B4-ABF13E43731B--PanGenie/results_genotyping-pipelines_prepare-vcf-MC/mc_filtered_ids.vcf.gz"
            panel_vcf_tbi       = "s3://human-pangenomics/submissions/89DF6EFF-E289-49A2-B2B4-ABF13E43731B--PanGenie/results_genotyping-pipelines_prepare-vcf-MC/mc_filtered_ids.vcf.gz.tbi"
            reference_fasta     = "${params.igenomes_base}/Homo_sapiens/Pangenome/HPRC_v2/chm13v2.0.fa"
        }
    }

    // Phasing resources (for phase_and_impute workflow)
    // TODO: S3 paths for phasing panel files
    phasing {
        // 1000 Genomes phasing panel lifted to T2T
        't2t' {
            panel               = "${params.igenomes_base}/Homo_sapiens/Pangenome/Phasing/T2T/1KGP.CHM13v2.{1..22,X}.phased.bcf.gz"
            panel_index         = "${params.igenomes_base}/Homo_sapiens/Pangenome/Phasing/T2T/1KGP.CHM13v2.{1..22,X}.phased.bcf.gz.csi"
            genetic_map         = "${params.igenomes_base}/Homo_sapiens/Pangenome/Phasing/T2T/genetic_maps/*.gmap.gz"
        }
        'grch38' {
            panel               = "${params.igenomes_base}/Homo_sapiens/Pangenome/Phasing/GRCh38/1KGP.GRCh38.{1..22,X}.phased.bcf.gz"
            panel_index         = "${params.igenomes_base}/Homo_sapiens/Pangenome/Phasing/GRCh38/1KGP.GRCh38.{1..22,X}.phased.bcf.gz.csi"
            genetic_map         = "${params.igenomes_base}/Homo_sapiens/Pangenome/Phasing/GRCh38/genetic_maps/*.gmap.gz"
        }
    }
}
